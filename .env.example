# Google API key for Gemini Vision analysis + Veo 3.1 animation
GOOGLE_API_KEY=your_google_api_key_here
# Optional: OpenAI API key for TTS (if using OpenAI TTS instead of edge-tts)
OPENAI_API_KEY=your_openai_api_key_here
# Optional: ElevenLabs API key for premium TTS
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Optional: Auto sign-in for storyboard --login
GOOGLE_EMAIL=you@example.com
GOOGLE_PASSWORD=your_google_password_here
# Optional: Clerk keys for any related frontend/admin integrations
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here
